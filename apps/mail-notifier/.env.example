# Copy this file to .env and fill in your own values:  cp .env.example .env
# Leave a mailbox's settings empty to turn it off.

# --- Outlook ---
# Application (client) ID of your Azure app (the same one as mail2jira works)
OUTLOOK_CLIENT_ID=
# true = only count Outlook's "Focused" inbox, ignoring "Other"
OUTLOOK_FOCUSED_ONLY=

# --- Gmail ---
GMAIL_ADDRESS=
# 16-character app password from myaccount.google.com/apppasswords (not your real password)
GMAIL_APP_PASSWORD=

# --- General ---
# How often to check, in seconds (minimum 15)
POLL_SECONDS=
STATS_PORT=
